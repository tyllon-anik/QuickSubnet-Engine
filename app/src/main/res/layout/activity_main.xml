<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QuickSubnet Engine"
            android:textColor="#58A6FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IPv4 Subnet Mask &amp; Range Analyzer"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <!-- Input Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="8dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP Address"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <EditText
                    android:id="@+id/etIpAddress"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#21262D"
                    android:fontFamily="monospace"
                    android:hint="e.g. 192.168.1.1"
                    android:inputType="numberDecimal"
                    android:digits="0123456789."
                    android:paddingHorizontal="12dp"
                    android:textColor="#00FF66"
                    android:textColorHint="#484F58"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="CIDR Prefix (/n)"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <EditText
                    android:id="@+id/etCidr"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#21262D"
                    android:fontFamily="monospace"
                    android:hint="e.g. 24 (range 0-32)"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#00FF66"
                    android:textColorHint="#484F58"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#238636"
                    android:fontFamily="monospace"
                    android:text="CALCULATE NETWORK"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Output Terminal Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="8dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// AUDIT RESULTS"
                    android:textColor="#79C0FF"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="5dp"
                    android:text="Enter an IP and prefix to run calculation."
                    android:textColor="#8B949E"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>